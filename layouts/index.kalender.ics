{{- /* Kalender-Abo /termine.ics mit allen kommenden Terminen.
       Nebenbei entstehen die Bausteine für /kalender/auswahl.ics?ak=… (siehe partials/kalender/bausteine.html). */ -}}
{{- $host := (urls.Parse site.BaseURL).Host -}}
{{- $alle := partial "termine.html" . -}}
{{- $konkret := where $alle "geplant" "!=" true -}}
{{- $serie := partial "kalender/serie.html" (dict "alle" $alle "host" $host) | strings.TrimSpace -}}
{{ partial "kalender/kopf.html" "VDI Hamburg – Young Engineers" | strings.TrimSpace }}
{{ with $serie }}{{ . }}
{{ end -}}
{{ range $konkret }}{{ partial "kalender/termin.html" (dict "e" . "host" $host) | strings.TrimSpace }}
{{ end -}}
END:VCALENDAR
{{- partial "kalender/bausteine.html" (dict "konkret" $konkret "serie" $serie "host" $host) -}}
