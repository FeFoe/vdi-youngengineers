[Unit]
Description=VDI Young Engineers Hamburg: Termine von vdi.de holen und Website bauen
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ye-website
Group=ye-website
# HUGO_BASEURL und HUGO_VORSCHAU (Vorschau: robots.txt verbietet alles, noindex)
EnvironmentFile=-/etc/default/ye-website
ExecStart=/srv/ye-website/repo/deploy/aktualisieren.sh --termine
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/srv/ye-website
