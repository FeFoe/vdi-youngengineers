[Unit]
Description=VDI Young Engineers Hamburg: Git holen und Website bauen
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ye-website
Group=ye-website
Environment=HUGO_BASEURL=https://young-engineers.vdi-hh.de/
ExecStart=/srv/ye-website/repo/deploy/aktualisieren.sh
# Härtung
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/srv/ye-website
