# Caddy: statische Auslieferung mit automatischem HTTPS (Let's Encrypt).
# Ziel auf der VM: /etc/caddy/Caddyfile – wird von deploy/einrichten.sh installiert.
#
# Kein `log`-Block = Caddy schreibt KEIN Zugriffsprotokoll (keine IP-Adressen gespeichert).
# Vorschau oder live steuert /etc/caddy/ye-zugang.caddy (von einrichten.sh geschrieben):
#   Vorschau: Passwortschutz + X-Robots-Tag noindex
#   Live:     leer
# Die Domains kommen aus YE_DOMAINS (systemd-Drop-in von einrichten.sh).

{
	email hamburg@young-engineers.vdi.de
}

{$YE_DOMAINS:vdiye.foerster.engineer} {
	root * /srv/ye-website/public
	encode zstd gzip

	import /etc/caddy/ye-zugang.caddy

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "geolocation=(), camera=(), microphone=(), interest-cohort=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	@statisch path /css/* /js/* /fonts/* *.webp *.woff2
	header @statisch Cache-Control "public, max-age=31536000, immutable"

	@ics path /termine.ics
	header @ics Content-Type "text/calendar; charset=utf-8"

	# „Meine Arbeitskreise“: Kalender wird beim Abruf aus den Bausteinen unter /kalender/ zusammengesetzt
	# (Vorlage assets/kalender/auswahl.caddy, Bausteine layouts/partials/kalender/bausteine.html)
	@auswahl path /kalender/auswahl.ics
	templates @auswahl {
		mime text/calendar
	}
	header @auswahl Content-Type "text/calendar; charset=utf-8"
	header @auswahl Cache-Control "public, max-age=3600"

	file_server

	handle_errors {
		rewrite * /404.html
		file_server
	}
}
